{
  "name": "vite-react-proj",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:remote": "npm run dev",
    "dev:remote:mac": "npm run dev",
    "dev:local": "set VITE_LOCAL=true&&vite",
    "dev:local:mac": "export VITE_LOCAL=true && vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run && npm run test:node",
    "test:watch": "vitest",
    "test:node": "node --test \"src/**/*.test.js\""
  },
  "dependencies": {
    "axios": "^1.5.0",
    "klinecharts": "^10.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "react-router-dom": "^6.16.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "jsdom": "^28.1.0",
    "sass": "^1.67.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.10"
  }
}
